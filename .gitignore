# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo

# Node / npm (in case any skill spawns local deps)
node_modules/
npm-debug.log*

# Python bytecode. hooks/docker-guard.py is the one Python hook, and anything
# that imports or byte-compiles it (`python3 -m py_compile`, a test run) drops a
# __pycache__/ next to it. Untracked-but-unignored, that lands in the next
# `git add -A` — which is exactly how a .pyc reached master once.
__pycache__/
*.py[cod]

# Local secrets / env
.env
.env.local
*.local

# Build / dist
dist/
build/
*.log

# Agent worktrees (repo-local) and session state.
# .agent-worktrees/ is the current objective/task layout; the platform-shaped
# paths below are the legacy layout and stay ignored so existing worktrees are
# never orphaned. See rules/dev/git-worktree-agent-workflow.md.
.agent-worktrees/
.claude/.worktrees/
.claude/worktrees/
.claude/outputs/
.claude/sessions/
.cursor/.worktrees/
.codex/.worktrees/
.gemini/.worktrees/
.opencode/.worktrees/

# Session-local dev artifacts and objective/task/handoff workflow state.
# Gitignored by default; only .dev-files/README.md is tracked. A consuming repo
# may opt in to durable checked-in workflow state by un-ignoring
# .dev-files/objectives/ in its own .gitignore — see
# rules/dev/dev-files-workspace.md. This repo does not opt in.
.dev-files/*
!.dev-files/README.md

# Session files (plans, reviews, investigations — visible but not committed)
session-files/
