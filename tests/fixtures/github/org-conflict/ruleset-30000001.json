{
  "id": 30000001,
  "name": "Org baseline - reviews",
  "target": "branch",
  "source_type": "Organization",
  "source": "ProductionMasterAI",
  "enforcement": "active",
  "node_id": "RRS_lACsT3JnYW5pemF0aW9uzgHi",
  "created_at": "2026-01-05T08:00:00.000Z",
  "updated_at": "2026-01-05T08:00:00.000Z",
  "current_user_can_bypass": "never",
  "bypass_actors": [],
  "conditions": {
    "ref_name": { "exclude": [], "include": ["~DEFAULT_BRANCH"] },
    "repository_name": { "exclude": [], "include": ["~ALL"] }
  },
  "rules": [
    {
      "type": "pull_request",
      "parameters": {
        "allowed_merge_methods": ["squash"],
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": true,
        "require_extra_approval_for_unattributed_changes": true,
        "require_last_push_approval": true,
        "required_approving_review_count": 2,
        "required_review_thread_resolution": true,
        "required_reviewers": []
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "do_not_enforce_on_create": false,
        "required_status_checks": [{ "context": "org/security-scan", "integration_id": 15368 }],
        "strict_required_status_checks_policy": true
      }
    }
  ],
  "_links": {
    "self": { "href": "https://api.github.com/orgs/ProductionMasterAI/rulesets/30000001" },
    "html": { "href": "https://github.com/organizations/ProductionMasterAI/settings/rules/30000001" }
  }
}
