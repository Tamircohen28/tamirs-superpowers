{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "tamirs-superpowers",
  "displayName": "Tamir's Superpowers",
  "version": "1.2.1",
  "description": "17 bundled skills, smart worktree hooks, statusline, and MCP server stubs — plan, implement, review, debug, multi-agent setup, and audit code from one plugin.",
  "homepage": "https://github.com/Tamircohen28/tamirs-superpowers",
  "repository": "https://github.com/Tamircohen28/tamirs-superpowers",
  "author": {
    "name": "Tamir Cohen",
    "url": "https://github.com/Tamircohen28"
  },
  "keywords": [
    "skills",
    "hooks",
    "developer-tools",
    "mcp",
    "claude-code",
    "worktree",
    "workflow"
  ],
  "license": "MIT",
  "defaultEnabled": true,
  "skills": [
    "./skills/creative",
    "./skills/debugging",
    "./skills/dev-workflow",
    "./skills/documentation",
    "./skills/mcp",
    "./skills/meta",
    "./skills/repo"
  ],
  "settings": {
    "statusLine": {
      "type": "command",
      "command": "bash ${CLAUDE_PLUGIN_ROOT}/statusline.sh"
    }
  }
}
