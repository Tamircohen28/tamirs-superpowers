{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "tamirs-superpowers",
  "displayName": "Tamir's Superpowers",
  "version": "1.8.2",
  "description": "25 bundled skills, 6 specialist agents, smart worktree hooks, statusline, and MCP server stubs — plan, implement, review, debug, multi-agent setup, and audit code from one plugin.",
  "homepage": "https://github.com/Tamircohen28/tamirs-superpowers",
  "repository": "https://github.com/Tamircohen28/tamirs-superpowers",
  "author": {
    "name": "Tamir Cohen",
    "url": "https://github.com/Tamircohen28"
  },
  "keywords": [
    "skills",
    "hooks",
    "developer-tools",
    "mcp",
    "claude-code",
    "worktree",
    "workflow"
  ],
  "license": "MIT",
  "defaultEnabled": true,
  "mcpServers": "./.mcp.json",
  "skills": [
    "./skills/creative",
    "./skills/debugging",
    "./skills/dev-workflow",
    "./skills/documentation",
    "./skills/mcp",
    "./skills/toolkit",
    "./skills/repo"
  ],
  "settings": {
    "statusLine": {
      "type": "command",
      "command": "f=$(ls $HOME/.claude/plugins/cache/tamirs-plugins/tamirs-superpowers/*/scripts/statusline.sh 2>/dev/null | sort -rV | head -1) && [ -n \"$f\" ] && bash \"$f\""
    }
  }
}
