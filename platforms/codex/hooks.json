{
  "description": "Generated by scripts/build-codex-hooks.sh from hooks/hooks.json - do not edit; regenerate with `bash scripts/build-codex-hooks.sh .`. Codex parses a hooks file with exactly two top-level keys (description, hooks), so the Claude `modules` entry that loads the mod is left out. The events Codex has no equivalent for (Notification, DirectoryAdded, WorktreeCreate, WorktreeRemove, StopFailure, TaskCompleted, TeammateIdle) are left out. Claude's per-hook `onFailure` is left out because Codex's command hook has no such field, so every guard is fail-open on Codex: a guard that crashes or times out lets the action through. ${CLAUDE_PLUGIN_ROOT} is kept because Codex exports it for compatibility.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Shell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/protect-other-branches.sh",
            "timeout": 15,
            "statusMessage": "Checking for concurrent agent work..."
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|StrReplace",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/enforce-worktree-edits.sh",
            "timeout": 10,
            "statusMessage": "Checking worktree isolation..."
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|StrReplace",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/guard-sensitive-files.sh",
            "timeout": 5,
            "statusMessage": "Checking for protected files..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/skill-creator-guard.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|Shell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/docker-guard.py\"",
            "timeout": 5,
            "statusMessage": "Checking for durable Docker state..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/guard-sensitive-files.sh",
            "timeout": 5,
            "statusMessage": "Checking for protected files..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/plugin-reload-reminder.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/validate-report-links.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/show-changelog.sh"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-init.sh"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/usage-capture-ensure.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-end.sh",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/handoff-reminder.sh",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/release-agent-claims.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/capture-task-slug.sh",
            "timeout": 60,
            "statusMessage": "Setting up worktree and session slug..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/goal-condition-lint.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/goal-compact-reminder.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/scope-decompose-reminder.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/ensure-exit.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/skill-suggest.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/check-done.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/subagent-handoff-check.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/precompact-snapshot.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
