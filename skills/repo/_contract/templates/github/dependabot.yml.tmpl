version: 2
updates:
  # npm (Node / Next.js) — include when package.json is present
  # Weekly, grouped minor+patch, no auto-major, max 3 open PRs.
  - package-ecosystem: "npm"
    directory: "/"
    schedule:
      interval: "weekly"
      day: "monday"
      time: "09:00"
    open-pull-requests-limit: 3
    groups:
      npm-patch-and-minor:
        patterns:
          - "*"
        update-types:
          - "minor"
          - "patch"
    ignore:
      - dependency-name: "*"
        update-types:
          - "version-update:semver-major"
    labels:
      - chore

  # pip (Python) — include when pyproject.toml / requirements.txt is present
  # Same conservative policy as npm above.
  # - package-ecosystem: "pip"
  #   directory: "/"
  #   schedule:
  #     interval: "weekly"
  #     day: "monday"
  #     time: "09:00"
