  #   groups:
  #     pip-patch-and-minor:
  #       patterns:
  #         - "*"
  #       update-types:
  #         - "minor"
  #         - "patch"
  #   ignore:
  #     - dependency-name: "*"
  #       update-types:
  #         - "version-update:semver-major"
  #   labels:
  #     - chore

  # GitHub Actions — always present, monthly cadence, grouped.
  - package-ecosystem: "github-actions"
    directory: "/"
    schedule:
      interval: "monthly"
    open-pull-requests-limit: 2
    groups:
      github-actions:
        patterns:
          - "*"
    labels:
      - chore
