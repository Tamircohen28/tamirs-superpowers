name: CI

on:
  push:
    branches: [master]
  pull_request:
    branches: [master]

jobs:
  CI:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version-file: .nvmrc
          cache: npm
      - run: npm ci
      - run: npm test

  secret-scan:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Scan for high-signal secret patterns
        run: |
          if grep -rE '(AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{36})' --include='*.json' --include='*.yml' .; then
            exit 1
          fi
          echo "No secrets found"
