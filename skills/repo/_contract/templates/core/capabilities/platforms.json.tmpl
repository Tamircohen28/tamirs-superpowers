  "capability_definitions": {
    "skills": {
      "summary": "Discovers and loads SKILL.md files shipped by this repo.",
      "degradation": "None possible — a target without skills is not a supported target."
    },
    "skill_auto_invocation": {
      "summary": "Selects a skill from its description without the user naming it.",
      "degradation": "Document the explicit invocation form (slash command or 'use the X skill') in the install guide."
    },
    "subagents": {
      "summary": "Delegates a bounded task to a separate agent with its own context.",
      "degradation": "Run the role inline in the main session, sequentially, with a narrowed scope."
    },
    "parallel_subagents": {
      "summary": "Runs two or more subagents concurrently.",
      "degradation": "Fan out sequentially; the task graph still holds, only wall-clock time changes."
    },
    "agent_teams": {
      "summary": "Long-lived named agents that message each other during a session.",
      "degradation": "Use one-shot subagents plus files under session-files/ as the message bus."
    },
    "hooks": {
      "summary": "Runs THIS REPO'S declared hook scripts on that platform's lifecycle events. Like every row here, this describes this repo's artifacts on that platform, not the platform's abstract feature set: the question is 'if I install this plugin there, do my hooks run?', not 'is that product hooks-capable?'",
      "degradation": "Move the guard into the skill body as an explicit step, and into CI as a check."
    },
    "mcp": {
      "summary": "Connects Model Context Protocol servers declared by the repo.",
      "degradation": "Use the equivalent CLI (gh, curl) through the shell capability."
    },
    "statusline": {
      "summary": "Renders a repo-provided status line in the session chrome.",
      "degradation": "Purely cosmetic — omit it. Never make a skill depend on it."
    },
    "shell": {
      "summary": "Executes arbitrary shell commands in the workspace.",
      "degradation": "Emit the commands for the user to run and wait for pasted output."
    },
    "git": {
      "summary": "Git is on PATH and the workspace is a repository.",
      "degradation": "Skip branch/commit/worktree workflows; skills that need them declare git as required."
    },
    "github_cli": {
      "summary": "The gh CLI is installed and authenticated.",
      "degradation": "Optional feature dependency. Fall back to printing the PR/issue body for the user to file manually."
    },
    "background_tasks": {
      "summary": "Runs a long command detached and reports its exit later.",
      "degradation": "Run in the foreground with a bounded timeout."
    },
    "worktree_isolation": {
      "summary": "Each task gets its own git worktree so concurrent agents do not collide.",
      "degradation": "Single checkout, one task at a time; the orchestrator serializes writes."
    },
    "plugin_marketplace": {
      "summary": "Installs and updates this plugin from a hosted marketplace listing.",
      "degradation": "Document a direct install path (git clone plus a local plugin/extension link)."
    },
    "extension_install": {
      "summary": "Installs the repo directly as an extension from a git URL.",
      "degradation": "Use the platform's own install path; this is not a universal mechanism."
    },
    "slash_commands": {
      "summary": "Exposes repo-provided commands as /name.",
      "degradation": "Users invoke the skill by describing it in prose."
    },
    "ask_user_question": {
      "summary": "Presents a structured multiple-choice question mid-run.",
      "degradation": "Ask in prose and stop for a free-text reply."
    },
    "artifacts": {
      "summary": "Publishes a rendered HTML/Markdown page as a shareable artifact.",
      "degradation": "Write the same content to a file in the repo and tell the user the path."
    },
    "session_transcripts": {
      "summary": "Session history is readable on disk in a documented format.",
      "degradation": "Usage analytics (session-report) are unavailable; say so rather than reporting zeros."
    }
  },
